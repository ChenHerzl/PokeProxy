POKEPROXY_CONFIG=/etc/pokeproxy/rules.json
POKEPROXY_HTTP_TIMEOUT=5
POKEPROXY_DOWNSTREAM_DEADLINE=10
POKEPROXY_UPLOAD_TIMEOUT=10
POKEPROXY_REDIS_TIMEOUT=0.25
POKEPROXY_CACHE_TTL=300
POKEPROXY_MAX_BODY_BYTES=65536
POKEPROXY_MAX_RESPONSE_BYTES=65536
POKEPROXY_MAX_INFLIGHT=16
POKEPROXY_CLOSE_TIMEOUT=2
