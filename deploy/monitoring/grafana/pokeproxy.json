{
  "uid": "pokeproxy-health",
  "title": "PokeProxy \u2014 Is it healthy right now?",
  "tags": [
    "pokeproxy"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Scraping proxy Pods",
      "description": "Scrape availability, not Kubernetes readiness. Zero means no proxy metrics are reachable; check Prometheus Targets and discovery RBAC.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"pokeproxy\"}) or vector(0)",
          "legendFormat": "Pods",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No traffic / no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Received / second",
      "description": "POST /stream handler entries. Excludes health checks, metrics scrapes and Uvicorn pre-handler rejection.",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(pokeproxy_requests_received_total{job=\"pokeproxy\"}[$__rate_interval])) or vector(0))",
          "legendFormat": "requests/s",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "No traffic / no data",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Successful handling",
      "description": "Forwarded HTTP <400 plus valid unmatched messages, divided by all finished handlers. Undefined at idle. Does not prove downstream side effects.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(pokeproxy_requests_total{job=\"pokeproxy\",outcome=~\"forwarded|unmatched\"}[$__rate_interval])) or vector(0)) / (sum(rate(pokeproxy_requests_total{job=\"pokeproxy\"}[$__rate_interval])) or vector(0))",
          "legendFormat": "success %",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "No traffic / no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Server error rate",
      "description": "Finished handlers with HTTP 5xx, divided by all finished handlers. Downstream 4xx is shown in the forwarding panel. Undefined at idle.",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(pokeproxy_requests_total{job=\"pokeproxy\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / (sum(rate(pokeproxy_requests_total{job=\"pokeproxy\"}[$__rate_interval])) or vector(0))",
          "legendFormat": "5xx %",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "No traffic / no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Traffic: received and finished",
      "description": "Received increments before admission; finished includes rejects and cancellations. The difference can represent in-flight work.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(pokeproxy_requests_received_total{job=\"pokeproxy\"}[$__rate_interval])) or vector(0))",
          "legendFormat": "received",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "(sum(rate(pokeproxy_requests_total{job=\"pokeproxy\"}[$__rate_interval])) or vector(0))",
          "legendFormat": "finished",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "No traffic / no data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Handler outcomes",
      "description": "Fixed application outcomes separate unmatched (valid 200), invalid_signature (401), invalid protobuf and downstream errors.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(pokeproxy_requests_total{job=\"pokeproxy\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "No traffic / no data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Handler latency: p50 / p95",
      "description": "Includes upload, cache, routing and downstream wait; excludes response transmission. Empty at idle. Bucket estimates aggregate across Pods.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(pokeproxy_request_duration_seconds_bucket{job=\"pokeproxy\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pokeproxy_request_duration_seconds_bucket{job=\"pokeproxy\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No traffic / no data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Downstream latency: p50 / p95",
      "description": "All completed downstream attempts, including failures, through bounded raw body read. Empty when no Pok\u00e9mon matches.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(pokeproxy_forward_duration_seconds_bucket{job=\"pokeproxy\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pokeproxy_forward_duration_seconds_bucket{job=\"pokeproxy\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No traffic / no data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Routing decisions by rule",
      "description": "First matching rule only. Rule IDs are configuration indices, not URLs. Reordering rules changes their meaning. No-match decisions appear under handler outcomes.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rule) (rate(pokeproxy_rule_matches_total{job=\"pokeproxy\"}[$__rate_interval]))",
          "legendFormat": "{{rule}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "No traffic / no data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "Downstream attempt outcomes",
      "description": "Success = HTTP <400; failures include HTTP >=400, timeout, transport, oversized response, cancellation and internal error. Cache hits still forward.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(pokeproxy_forward_total{job=\"pokeproxy\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "No traffic / no data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "title": "Cache operation outcomes",
      "description": "Reads are hit/miss/read_error; writes are write/write_error. A failed read is not a miss. Cache failures fall back to normal processing.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(pokeproxy_cache_total{job=\"pokeproxy\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "No traffic / no data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "title": "Cache hit ratio (successful reads)",
      "description": "Hits / (hits + misses). Excludes read errors and writes. Low hit ratio is not inherently unhealthy; undefined without successful reads.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(pokeproxy_cache_total{job=\"pokeproxy\",outcome=\"hit\"}[$__rate_interval])) or vector(0)) / (sum(rate(pokeproxy_cache_total{job=\"pokeproxy\",outcome=~\"hit|miss\"}[$__rate_interval])) or vector(0))",
          "legendFormat": "hit %",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "No traffic / no data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 13,
      "title": "Admitted requests in flight",
      "description": "Actual current handler work, per Pod. Decrements on completion/cancellation. Does not include response transmission or requests rejected before admission.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pokeproxy_inflight{job=\"pokeproxy\"}",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No traffic / no data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 14,
      "title": "Proxy process CPU",
      "description": "CPU seconds per second = CPU cores used by the single Python process. Not whole-Pod usage or CPU throttling.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"pokeproxy\"}[$__rate_interval])",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "min": 0,
          "noValue": "No traffic / no data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 15,
      "title": "Proxy process resident memory",
      "description": "Resident bytes from /proc for the proxy process. Not cgroup working set, Pod memory consumption, or a Kubernetes limit measurement.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"pokeproxy\"}",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "noValue": "No traffic / no data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 16,
      "title": "Proxy process uptime",
      "description": "Time since current process start per Pod. Drops on a restart; this is not a Kubernetes restart counter.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - process_start_time_seconds{job=\"pokeproxy\"}",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No traffic / no data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 17,
      "title": "Alert states",
      "description": "1 indicates an active pending/firing alert. Empty means no active PokeProxy alert series; always check scrape health above.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{service=\"pokeproxy\"}",
          "legendFormat": "{{alertname}} / {{alertstate}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No traffic / no data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
